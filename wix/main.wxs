<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v3 installer for HelixView (Windows x64).
  Used by cargo-wix — place this file at wix/main.wxs.
  Run:  cargo wix --no-build
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="HelixView"
           Language="1033"
           Version="0.1.0"
           Manufacturer="HelixView Contributors"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">

    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" Platform="x64"/>
    <MajorUpgrade DowngradeErrorMessage="A newer version of HelixView is already installed."/>
    <MediaTemplate EmbedCab="yes"/>

    <!-- ── Directories ── -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="HelixView"/>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="HelixView"/>
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop"/>
    </Directory>

    <!-- ── Components ── -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*" Win64="yes">
        <File Id="HelixViewExe"
              Source="target\x86_64-pc-windows-msvc\release\helixview.exe"
              KeyPath="yes">
          <Shortcut Id="StartMenuShortcut"
                    Directory="ApplicationProgramsFolder"
                    Name="HelixView"
                    Description="Biological sequence alignment editor"
                    WorkingDirectory="INSTALLFOLDER"
                    Advertise="yes"/>
          <Shortcut Id="DesktopShortcut"
                    Directory="DesktopFolder"
                    Name="HelixView"
                    Description="Biological sequence alignment editor"
                    WorkingDirectory="INSTALLFOLDER"
                    Advertise="yes"/>
        </File>
      </Component>
      <Component Id="CliExecutable" Guid="*" Win64="yes">
        <File Id="HelixViewCliExe"
              Source="target\x86_64-pc-windows-msvc\release\helixview-cli.exe"
              KeyPath="yes"/>
        <!-- Add CLI dir to PATH -->
        <Environment Id="PATH"
                     Name="PATH"
                     Value="[INSTALLFOLDER]"
                     Permanent="no"
                     Part="last"
                     Action="set"
                     System="yes"/>
      </Component>
    </DirectoryRef>

    <!-- Start menu folder cleanup on uninstall -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcutsFolder" Guid="*">
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall"/>
        <RegistryValue Root="HKCU"
                       Key="Software\HelixView"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <!-- ── Feature ── -->
    <Feature Id="Complete" Level="1">
      <ComponentRef Id="MainExecutable"/>
      <ComponentRef Id="CliExecutable"/>
      <ComponentRef Id="ApplicationShortcutsFolder"/>
    </Feature>

    <!-- ── UI ── -->
    <UIRef Id="WixUI_InstallDir"/>
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER"/>

  </Product>
</Wix>
